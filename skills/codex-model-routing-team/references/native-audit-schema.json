{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Native Subagent Worker Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "worker_attempt",
    "subtask_attempt",
    "task_id",
    "surface",
    "agent_id",
    "control_state",
    "agent_status",
    "last_observed_at",
    "fork_mode",
    "role",
    "model",
    "requested_model",
    "platform_accepted_model",
    "observed_runtime_model",
    "thinking",
    "route_plan",
    "provider_policy",
    "status",
    "output",
    "adopted",
    "fallback_reason",
    "closed"
  ],
  "properties": {
    "worker_attempt": {"type": "integer", "minimum": 1, "maximum": 16},
    "subtask_attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "surface": {"const": "native_subagent"},
    "agent_id": {"type": ["string", "null"]},
    "control_state": {
      "type": "string",
      "enum": ["PLANNED", "SPAWN_PENDING", "RUNNING", "COMPLETED", "UNKNOWN", "FAILED", "RELEASED", "CLOSED"]
    },
    "agent_status": {"type": ["string", "null"]},
    "last_observed_at": {"type": ["string", "null"], "format": "date-time"},
    "fork_mode": {"type": "string", "enum": ["fresh", "recent"]},
    "fork_turns": {"type": "string", "pattern": "^(none|[1-9][0-9]*)$"},
    "unit_id": {"type": "string", "pattern": "^U[1-9][0-9]*$"},
    "team_plan_revision": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "requested_model": {"type": "string", "minLength": 1},
    "platform_accepted_model": {"type": ["string", "null"]},
    "observed_runtime_model": {"type": ["string", "null"]},
    "thinking": {"type": "string", "minLength": 1},
    "requested_speed": {"type": "string", "enum": ["standard", "fast"]},
    "platform_accepted_speed": {"type": ["string", "null"], "enum": ["standard", "fast", null]},
    "observed_runtime_speed": {"type": ["string", "null"], "enum": ["standard", "fast", "unknown", null]},
    "route_plan": {"type": "object"},
    "provider_policy": {"type": "object"},
    "status": {"type": "string", "minLength": 1},
    "output": {"type": ["string", "null"]},
    "adopted": {"type": "boolean"},
    "fallback_reason": {"type": ["string", "null"]},
    "closed": {"type": "boolean"},
    "released": {"type": "boolean"},
    "release_method": {"type": ["string", "null"], "enum": ["close", "completed_idle", null]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "route_plan": {
            "type": "object",
            "properties": {"schema_version": {"const": "3.0"}},
            "required": ["schema_version"]
          }
        },
        "required": ["route_plan"]
      },
      "then": {
        "required": ["fork_turns", "released", "release_method"],
        "allOf": [
          {
            "if": {
              "properties": {"control_state": {"const": "RELEASED"}},
              "required": ["control_state"]
            },
            "then": {
              "properties": {
                "released": {"const": true},
                "release_method": {"enum": ["close", "completed_idle"]}
              }
            }
          },
          {
            "if": {
              "properties": {"release_method": {"const": "completed_idle"}},
              "required": ["release_method"]
            },
            "then": {
              "properties": {
                "control_state": {"const": "RELEASED"},
                "released": {"const": true},
                "agent_status": {"type": "string", "enum": ["completed", "idle"]}
              },
              "required": ["control_state", "released", "agent_status"]
            }
          }
        ]
      }
    }
  ]
}
